{
  "name": "boulde",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "docker compose -f ../compose.yml up -d --wait neo4j storage && docker compose -f ../compose.yml run --rm storage-init && npm run db:migrate && npm run db:seed",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:integration": "sh scripts/test-integration.sh",
    "test:e2e": "npm run db:setup && docker run --rm --network host -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.55.0-noble npx playwright test",
    "test:e2e:local": "npm run db:setup && playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "neo4j-driver": "^6.2.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}

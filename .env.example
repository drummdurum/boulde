AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=true
APP_URL=https://your-boulde-domain.up.railway.app
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
